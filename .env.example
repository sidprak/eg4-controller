# EG4 account
EG4_USERNAME=
EG4_PASSWORD=

# Optional: target a specific inverter. If unset, the first one (index 0) is used.
EG4_SERIAL_NUMBER=

# Cloud host. Leave default unless EG4 changes it.
EG4_BASE_URL=https://monitor.eg4electronics.com

# PV power (watts) above which the discharge cap is forced to 0 A.
EG4_PV_THRESHOLD_W=1700

# On-grid Cut-Off SOC (%) restored OUTSIDE the solar window. Default 2
# matches the typical FlexBOSS21 factory setting; set to whatever shows in
# the EG4 web UI as "On-Grid Cut-Off SOC(%)" today.
EG4_NORMAL_DISCHARGE_SOC=2

# On-grid Cut-Off SOC (%) written when the cap is ON. 100 = "stop
# discharging at any SOC". If your firmware silently clamps below 100 (the
# script's verify step will report verify=fail), try 99 or 95.
EG4_CAP_ON_SOC=100

# Exact hold-register key. Default HOLD_DISCHG_CUT_OFF_SOC_EOD ("On-Grid
# Cut-Off SOC") has been verified on FlexBOSS21. Critically, this does NOT
# affect off-grid/EPS discharge — that uses HOLD_SOC_LOW_LIMIT_EPS_DISCHG —
# so battery backup remains fully available if the grid fails.
EG4_HOLD_PARAM_DISCHARGE=HOLD_DISCHG_CUT_OFF_SOC_EOD

# Runtime field used to read PV power in watts. Default `ppv` works on most
# firmwares; check --discover output if not.
EG4_PV_FIELD=ppv

# Safety: 1 = decide+log only, never write. Keep ON until --discover has
# confirmed the hold-param key.
EG4_DRY_RUN=1

# Skip SSL verification (1/0). Only flip if your network proxies EG4.
EG4_DISABLE_VERIFY_SSL=0

# Optional log file path (in addition to stdout).
EG4_LOG_FILE=
