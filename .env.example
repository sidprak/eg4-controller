# EG4 account
EG4_USERNAME=
EG4_PASSWORD=

# Optional: target a specific inverter. If unset, the first one (index 0) is used.
EG4_SERIAL_NUMBER=

# Cloud host. Leave default unless EG4 changes it.
EG4_BASE_URL=https://monitor.eg4electronics.com

# --- EV-load trigger (GridBoss smart port) ---------------------------------
# The cap engages only while the EV charger is actively drawing power on its
# GridBoss smart port, so normal household loads and idle periods never trip
# it. Power is read from the GridBoss (MidBox) runtime, summing the port's
# L1+L2 active power.

# GridBoss serial (the batteryless MidBox device). If blank, auto-detected as
# the account's NO_BATTERY device. Run `guardrail.py --discover` to see it and
# a per-smart-port power sample.
EG4_GRIDBOSS_SERIAL=

# GridBoss smart port the EV charger is wired to (1-4). UI: "Smart Port N".
EG4_EV_SMART_PORT=1

# EV-load watt thresholds with hysteresis. Cap turns ON above EG4_EV_CAP_ON_W
# and OFF below EG4_EV_CAP_OFF_W; between the two, the previous state is held.
# The Emporia only excess-solar charges at >=7A@240V (~1680W) or not at all,
# so the smart port reads ~0 (idle) or >=1680 (charging) with a clean gap.
EG4_EV_CAP_ON_W=1500
EG4_EV_CAP_OFF_W=1000

# On-grid discharge SOC cutoff (%) restored when the EV is NOT charging.
# Default 2 matches the typical FlexBOSS21 setting; set whatever shows in
# the EG4 web UI as "On-Grid Cut-Off SOC(%)" today. Requires the inverter's
# "Batt Discharge Control" to be SOC mode (not Voltage).
EG4_NORMAL_DISCHARGE_SOC=2

# On-grid discharge SOC cutoff (%) written when the EV IS charging. 100 forbids
# any on-grid battery discharge: the EV's load above PV pulls from grid instead
# of the battery, so the Emporia sees real grid import and throttles. Off-grid/
# EPS discharge is preserved via the separate HOLD_SOC_LOW_LIMIT_EPS_DISCHG
# floor. Range 0-100.
EG4_CAP_ON_SOC=100

# Exact hold-register key. Default HOLD_DISCHG_CUT_OFF_SOC_EOD ("On-Grid
# Cut-Off SOC(%)") is verified on FlexBOSS21. Live-confirmed that cap-on
# blocks on-grid discharge while PV->loads pass-through and EPS backup
# stay intact. Off-grid uses a separate floor and is never touched.
EG4_HOLD_PARAM_DISCHARGE=HOLD_DISCHG_CUT_OFF_SOC_EOD

# --- Cloudy-day battery top-up (optional) ----------------------------------
# Set to 1 after configuring the inverter's native AC Charge schedule to its
# time-based / "According to Time" mode with a 14:00-15:00 window and all other
# AC Charge windows disabled. The controller arms AC Charge during the 30
# minutes before the window only when SOC is below target, disables it as soon
# as target is reached, and keeps it off afterward. This restores
# self-consumption instead of leaving the house on grid bypass.
EG4_TOP_UP_ENABLED=0
EG4_TOP_UP_TIMEZONE=America/Los_Angeles
EG4_TOP_UP_START=14:00
EG4_TOP_UP_END=15:00
EG4_TOP_UP_ARM_MINUTES=30
EG4_TOP_UP_TARGET_SOC=65

# FlexBOSS21 cloud hold-parameter names for the AC Charge switch and SOC limit.
# Confirm both with --discover before enabling top-up on another inverter model.
EG4_HOLD_PARAM_AC_CHARGE=FUNC_AC_CHARGE
EG4_HOLD_PARAM_AC_CHARGE_SOC=HOLD_AC_CHARGE_SOC_LIMIT

# Runtime field used to read PV power in watts (logged as context only; the
# decision is driven by EV-load, not PV). Default `ppv` works on most
# firmwares; check --discover output if not.
EG4_PV_FIELD=ppv

# Safety: 1 = decide+log only, never write. Keep ON until --discover has
# confirmed the hold-param key.
EG4_DRY_RUN=1

# Skip SSL verification (1/0). Only flip if your network proxies EG4.
EG4_DISABLE_VERIFY_SSL=0

# Optional log file path (in addition to stdout).
EG4_LOG_FILE=
