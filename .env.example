# EG4 account
EG4_USERNAME=
EG4_PASSWORD=

# Optional: target a specific inverter. If unset, the first one (index 0) is used.
EG4_SERIAL_NUMBER=

# Cloud host. Leave default unless EG4 changes it.
EG4_BASE_URL=https://monitor.eg4electronics.com

# PV power (watts) thresholds with hysteresis to avoid flapping on spiky
# clouds. Cap turns ON above EG4_PV_CAP_ON_W and OFF below EG4_PV_CAP_OFF_W;
# between the two, the previous state is held.
EG4_PV_CAP_ON_W=1700
EG4_PV_CAP_OFF_W=1200

# Legacy single-threshold knob. Only used if the two above aren't set;
# defaults the on threshold to this value and the off threshold to this - 500.
# Prefer the explicit CAP_ON_W / CAP_OFF_W pair.
EG4_PV_THRESHOLD_W=1700

# On-grid discharge SOC cutoff (%) restored OUTSIDE the solar window.
# Default 2 matches the typical FlexBOSS21 setting; set whatever shows in
# the EG4 web UI as "On-Grid Cut-Off SOC(%)" today. Requires the inverter's
# "Batt Discharge Control" to be SOC mode (not Voltage).
EG4_NORMAL_DISCHARGE_SOC=2

# On-grid discharge SOC cutoff (%) written when the cap is ON. 100 forbids
# any on-grid battery discharge: loads above PV pull from grid instead of
# from the battery. Off-grid/EPS discharge is preserved via the separate
# HOLD_SOC_LOW_LIMIT_EPS_DISCHG floor. Range 0-100.
EG4_CAP_ON_SOC=100

# Exact hold-register key. Default HOLD_DISCHG_CUT_OFF_SOC_EOD ("On-Grid
# Cut-Off SOC(%)") is verified on FlexBOSS21. Live-confirmed that cap-on
# blocks on-grid discharge while PV->loads pass-through and EPS backup
# stay intact. Off-grid uses a separate floor and is never touched.
EG4_HOLD_PARAM_DISCHARGE=HOLD_DISCHG_CUT_OFF_SOC_EOD

# Runtime field used to read PV power in watts. Default `ppv` works on most
# firmwares; check --discover output if not.
EG4_PV_FIELD=ppv

# Safety: 1 = decide+log only, never write. Keep ON until --discover has
# confirmed the hold-param key.
EG4_DRY_RUN=1

# Skip SSL verification (1/0). Only flip if your network proxies EG4.
EG4_DISABLE_VERIFY_SSL=0

# Optional log file path (in addition to stdout).
EG4_LOG_FILE=
